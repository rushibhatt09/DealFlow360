datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SALES_REP
  SALES_MANAGER
  FINANCE
  ADMIN
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  UNDER_NEGOTIATION
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum ApprovalLevel {
  MANAGER
  FINANCE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum LineType {
  ONE_TIME
  SUBSCRIPTION
}

enum FulfillmentStatus {
  PLANNED
  BACKORDER
  SHIPPED
}

enum BillingStatus {
  UPCOMING
  INVOICED
  PAID
  CREDITED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

enum SubscriptionInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum NegotiationAuthor {
  CUSTOMER
  REP
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())

  // Per-user feature visibility, set by an Admin on the Users & Permissions
  // page. Enforced fresh on every page load (not cached in the session),
  // so a change takes effect immediately -- not just on next login.
  canViewPipeline    Boolean @default(true)
  canViewDealHealth  Boolean @default(true)
  canSeeUpsellPanel  Boolean @default(true)

  // Admin backend section access, split into View (read-only) and Edit
  // (can also create/change records) per section -- Edit without View
  // makes no sense, so the server always treats Edit as implying View
  // regardless of what's literally submitted. ADMIN role bypasses all of
  // these (always full access); every other role starts locked out and
  // an Admin grants view or edit one section at a time. Users &
  // Permissions itself has no toggle -- it's hardcoded Admin-only.
  // Reports has no Edit variant: there's nothing on that page to edit.
  canViewProducts        Boolean @default(false)
  canEditProducts        Boolean @default(false)
  canViewDiscounts       Boolean @default(false)
  canEditDiscounts       Boolean @default(false)
  canViewWarehouses      Boolean @default(false)
  canEditWarehouses      Boolean @default(false)
  canViewSubscriptions   Boolean @default(false)
  canEditSubscriptions   Boolean @default(false)
  canViewUpsellRules     Boolean @default(false)
  canEditUpsellRules     Boolean @default(false)
  canViewCustomers       Boolean @default(false)
  canEditCustomers       Boolean @default(false)
  canViewReports         Boolean @default(false)

  quotations     Quotation[]      @relation("RepQuotations")
  approvalSteps  ApprovalStep[]
  auditLogs      AuditLog[]
}

model Customer {
  id               String   @id @default(cuid())
  name             String
  tier             CustomerTier @default(BRONZE)
  portalEmail      String   @unique
  portalPasswordHash String
  createdAt        DateTime @default(now())

  quotations Quotation[]

  @@index([tier])
  @@index([name])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String
  unitPrice   Float
  unitCost    Float
  unit        String   @default("unit")
  taxPct      Float    @default(0)
  description String?

  stockItems       StockItem[]
  quotationLines   QuotationLine[]
  upsellBase       UpsellRule[] @relation("BaseProduct")
  upsellSuggested  UpsellRule[] @relation("SuggestedProduct")

  @@index([category])
  @@index([name])
}

model DiscountCeiling {
  id          String       @id @default(cuid())
  tier        CustomerTier
  category    String
  maxDiscountPct Float

  @@unique([tier, category])
}

model ApprovalRule {
  id              String   @id @default(cuid())
  minScore        Float
  maxScore        Float?
  requiresManager Boolean  @default(true)
  requiresFinance Boolean  @default(false)
}

/// A line whose pre-discount value crosses minLineValue automatically
/// earns bonusDiscountPct on top of whatever the rep enters -- a real
/// volume incentive, admin-configurable, not a hardcoded percentage.
model VolumeDiscountRule {
  id               String @id @default(cuid())
  minLineValue     Float
  bonusDiscountPct Float
}

model Warehouse {
  id                 String   @id @default(cuid())
  name               String
  shippingCostWeight Float    @default(1)

  stockItems StockItem[]
  splits     FulfillmentSplit[]
}

model StockItem {
  id          String   @id @default(cuid())
  warehouseId String
  productId   String
  qty         Int

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

model SubscriptionPlan {
  id               String               @id @default(cuid())
  name             String
  interval         SubscriptionInterval
  prorationEnabled Boolean              @default(true)

  quotationLines QuotationLine[]
}

model Quotation {
  id           String          @id @default(cuid())
  customerId   String
  repId        String
  status       QuotationStatus @default(DRAFT)
  riskScore    Float           @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  lastActivityAt DateTime      @default(now())

  customer       Customer         @relation(fields: [customerId], references: [id])
  rep            User             @relation("RepQuotations", fields: [repId], references: [id])
  lines          QuotationLine[]
  approvalSteps  ApprovalStep[]
  splits         FulfillmentSplit[]
  billingEntries BillingScheduleEntry[]
  negotiations   NegotiationMessage[]
  invoices       Invoice[]

  @@index([customerId])
  @@index([repId])
  @@index([status])
  @@index([updatedAt])
}

model QuotationLine {
  id                 String   @id @default(cuid())
  quotationId        String
  productId          String
  qty                Int
  unitPrice          Float
  discountPct        Float    @default(0)
  lineType           LineType @default(ONE_TIME)
  subscriptionPlanId String?
  addedViaUpsell     Boolean  @default(false)

  quotation        Quotation         @relation(fields: [quotationId], references: [id])
  product          Product           @relation(fields: [productId], references: [id])
  subscriptionPlan SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  splits           FulfillmentSplit[]
  billingEntries   BillingScheduleEntry[]
}

model ApprovalStep {
  id          String         @id @default(cuid())
  quotationId String
  level       ApprovalLevel
  sequence    Int
  status      ApprovalStatus @default(PENDING)
  reviewerId  String?
  reason      String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id])
  reviewer  User?     @relation(fields: [reviewerId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  detail     String?
  userId     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

model FulfillmentSplit {
  id              String            @id @default(cuid())
  quotationId     String
  quotationLineId String
  warehouseId     String
  qty             Int
  status          FulfillmentStatus @default(PLANNED)

  quotation     Quotation     @relation(fields: [quotationId], references: [id])
  quotationLine QuotationLine @relation(fields: [quotationLineId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
}

model BillingScheduleEntry {
  id              String        @id @default(cuid())
  quotationId     String
  quotationLineId String
  periodStart     DateTime
  periodEnd       DateTime
  amount          Float
  status          BillingStatus @default(UPCOMING)

  quotation     Quotation     @relation(fields: [quotationId], references: [id])
  quotationLine QuotationLine @relation(fields: [quotationLineId], references: [id])
}

model NegotiationMessage {
  id                 String            @id @default(cuid())
  quotationId        String
  author             NegotiationAuthor
  message             String
  counterDiscountPct Float?
  createdAt          DateTime          @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id])
}

model UpsellRule {
  id                 String  @id @default(cuid())
  baseProductId      String
  suggestedProductId String
  minMarginPct       Float   @default(0)
  promoted           Boolean @default(false)

  baseProduct      Product @relation("BaseProduct", fields: [baseProductId], references: [id])
  suggestedProduct Product @relation("SuggestedProduct", fields: [suggestedProductId], references: [id])
}

model Invoice {
  id          String        @id @default(cuid())
  quotationId String
  amount      Float
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime      @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id])
  payments  Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  method    String
  paidAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}
